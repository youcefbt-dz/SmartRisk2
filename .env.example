# انسخ هذا الملف إلى .env (أو صدّر المتغيرات) ثم عدّل ما يلزم
SMARTRISK_SECRET_KEY=غيّر-هذه-القيمة-في-الإنتاج
SMARTRISK_AUTH=true              # false = وضع محلي بدون تسجيل دخول
SMARTRISK_ALLOW_REGISTRATION=true
SMARTRISK_HTTPS=false            # true عند النشر خلف HTTPS
SMARTRISK_DB=instance/smartrisk.db
